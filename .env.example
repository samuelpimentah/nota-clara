# Sem estas variáveis, o servidor usa contas locais e arquivos em .local-data/.
# O modo local é bloqueado na Vercel. Nunca configure uma service_role no cliente.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Opcional: caminho absoluto para armazenamento/testes locais.
# LOCAL_DATA_DIR=
